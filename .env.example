# Web server (giao diện chạy tại http://HOST:PORT). Mặc định chỉ cho phép truy cập từ chính máy này.
HOST=127.0.0.1
PORT=8000
# Số yêu cầu tối đa mỗi phút cho một phiên trình duyệt.
RATE_LIMIT_PER_MINUTE=60

# Lưu trữ SQLite: hội thoại, cài đặt và API key (mã hóa). Để DB_PATH trống để chỉ giữ trong RAM.
DB_PATH=data/healthbot.db
# Tự xóa dữ liệu của phiên không hoạt động quá số ngày này.
RETENTION_DAYS=30
# Khóa mã hóa API key. Để trống thì tự tạo tệp data/.storage.key ở lần chạy đầu (đừng đưa lên git).
# Tạo khóa: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_SECRET=
# Quãng nghỉ giữa các câu khi đọc thành tiếng (giây, ở tốc độ bình thường).
LOCAL_TTS_SENTENCE_PAUSE=0.35

# Chat backend
OPENAI_MODEL=gpt-4.1-mini
# --- Tài khoản đăng nhập ---
# AUTH_REQUIRED=1 (mặc định): phải đăng nhập mới dùng được; mỗi tài khoản có cấu hình, API key và dữ liệu riêng.
# Đặt 0 để chạy chế độ ẩn danh (không tài khoản), chỉ nên dùng trên máy cá nhân.
AUTH_REQUIRED=1
# Cho phép người lạ tự tạo tài khoản. Đặt 0 rồi tạo tài khoản bằng: python manage.py create-user TÊN
ALLOW_REGISTRATION=1
# Giới hạn tổng số tài khoản (0 = không giới hạn).
MAX_ACCOUNTS=0
# Đăng nhập được giữ bao nhiêu ngày.
SESSION_DAYS=30
# Đặt 1 khi chạy sau nginx/Caddy để lấy đúng IP người dùng và đánh dấu cookie là Secure khi dùng HTTPS.
TRUST_PROXY=0
# Nếu OPENAI_API_KEY, GEMINI_API_KEY... được đặt ở dưới, tài khoản chưa nhập key riêng sẽ dùng key chung này.
# Đặt 0 để bắt buộc mỗi tài khoản tự nhập key (khuyến nghị khi mở đăng ký công khai).
SERVER_KEY_FALLBACK=1
# Cho phép nhà cung cấp "Tùy chỉnh" trỏ tới địa chỉ nội bộ (http, LAN). Mặc định chặn để tránh bị lợi dụng truy cập mạng nội bộ.
ALLOW_PRIVATE_BASE_URL=0
# Key chung theo từng nhà cung cấp (tùy chọn; người dùng vẫn nhập key riêng được trong Cài đặt).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Dùng API key thay cho Ollama (không cần cài Ollama) ---
# DEFAULT_BACKEND=openai : người dùng mới tự dùng OpenAI với OPENAI_API_KEY của máy chủ (chi phí tính vào key này).
# Để trống OPENAI_API_KEY thì mỗi người dùng tự nhập key trong Cài đặt.
DEFAULT_BACKEND=local
OPENAI_API_KEY=
# Đổi nếu dùng nhà cung cấp tương thích OpenAI khác (Azure, OpenRouter, Groq, vLLM...).
OPENAI_BASE_URL=https://api.openai.com/v1
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Vision model served by the same OpenAI-compatible local endpoint.
# Face photos are checked automatically first; non-face images keep the normal image/OCR flow.
# When set, this local vision model is used even if the chat backend is OpenAI.
# Leave blank to turn off local vision; the installed FER CNN can still classify faces locally.
LOCAL_VISION_MODEL=qwen3-vl:4b
# Keep image answers short enough for chat delivery. Local Ollama vision also
# disables model thinking so this budget is reserved for the final answer.
VISION_MAX_TOKENS=1024
# Face classification may use hidden reasoning tokens on qwen3-vl:4b.
FACE_VISION_MAX_TOKENS=2048
# Face observation alone keeps more image detail (previously limited to 2048 px).
# Higher values use more memory and may take longer; allowed range: 512-4096 px.
FACE_VISION_MAX_EDGE=3072
# Local ViT + CNN with a public-only calibrated fusion head.
# Run python setup_fer_vit.py once. Legacy rollback: ID=legacy and path=webapp.onnx.
FER_MODEL_ID=vit-fer2013
FER_MODEL_PATH=.models/fer2013/vit-fer2013-fp32.onnx
FER_CPU_THREADS=2
FER_CAMERA_MODEL_PATH=.models/fer2013/fer-camera.onnx
FER_PATT_MODEL_PATH=.models/fer2013/patt-lite-raf.onnx
FER_DEFAULT_PROFILE=camera
# Bộ dò khuôn mặt: auto = YuNet nếu đã chạy `python setup_yunet.py`, nếu chưa thì Haar. Có thể ép: yunet | haar.
FACE_DETECTOR=auto
YUNET_MODEL_PATH=
# Xoay khuôn mặt cho hai mắt nằm ngang trước khi nhận dạng (cần YuNet). 0 để tắt.
FACE_ALIGN=1

# Local voice backend. The server starts this loopback service on demand.
DEFAULT_VOICE_MODE=local
LOCAL_VOICE_URL=http://127.0.0.1:8765
LOCAL_VOICE_AUTOSTART=1
LOCAL_VOICE_STARTUP_TIMEOUT=300
LOCAL_VOICE_MODEL_DIR=.models/voice
LOCAL_STT_MODEL=small
LOCAL_STT_DEVICE=cuda
LOCAL_STT_COMPUTE_TYPE=float16
# Thiếu CUDA thì tự chuyển sang CPU (int8). Đặt 1 để bắt buộc dùng GPU và báo lỗi nếu không có.
LOCAL_STT_STRICT_CUDA=0
# Optional on Windows when CUDA DLLs are not already available on PATH.
LOCAL_CUDA_DLL_DIR=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.9\bin
# Piper by default. For VieNeu: pip install -r requirements-vieneu.txt,
# set LOCAL_TTS_PROVIDER=vieneu and LOCAL_TTS_VOICE=vieneu-default.
LOCAL_TTS_PROVIDER=piper
LOCAL_TTS_VOICE=vi_VN-vais1000-medium
# Keep Hugging Face downloads on the project's drive (Whisper / VieNeu).
HF_HOME=.runtime/huggingface

VOICE_TTS_MAX_CHARS=1000
# Tốc độ đọc mặc định (0.5 = rất chậm, 1.0 = bình thường, 1.3 = nhanh). Mỗi người dùng chỉnh được trong Cài đặt.
DEFAULT_TTS_SPEED=0.9

MAX_AUDIO_BYTES=10485760
LOG_LEVEL=INFO

# Zalo Bot: runs inside the web server, sharing its DB/core. Never run legacy_zalo/main.py alongside it.
ZALO_ENABLED=0
# Optional override when native web and Docker coexist; only one may poll a token.
ZALO_DOCKER_ENABLED=
ZALO_BOT_TOKEN=
# polling for localhost; webhook for public HTTPS deployment.
ZALO_MODE=polling
ZALO_WEBHOOK_SECRET=
# Optional public HTTPS address of this app, needed to send VieNeu AAC audio to Zalo.
ZALO_PUBLIC_BASE_URL=
# Forward web conversations to the linked private Zalo chat.
ZALO_MIRROR_WEB=1

# Lesson summarization and local OCR
SUMMARY_PENDING_SECONDS=300
SUMMARY_MAX_FILE_BYTES=10485760
SUMMARY_MAX_CHARS=50000
SUMMARY_MAX_PDF_PAGES=20
SUMMARY_MAX_IMAGE_PIXELS=20000000
OCR_LANG=vie+eng
# Full path to tesseract.exe. Leave blank when tesseract is already on PATH.
TESSERACT_CMD=
# Directory containing pdftoppm.exe. Leave blank when Poppler is already on PATH.
POPPLER_BIN=
